{
  "name": "@transl8.ai/plugin-sdk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EverRest/transl8-plugin-sdk.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2",
    "vitest": "^3.2.6"
  }
}
